# Copy to .env.local for development, and add the same values in Vercel.

# --- Contact & enquiry forms -------------------------------------------------
# Create an API key at https://resend.com
RESEND_API_KEY=
# Lead recipients; separate several addresses with commas.
CONTACT_TO_EMAIL=contact@marketixstudio.com
# Must use a domain verified in your Resend account.
CONTACT_FROM_EMAIL=Marketix Studio <website@marketixstudio.com>

# --- AI: Jay Ganesh review drafts (/r/[client]) and the Shalz chat assistant ---
# Set ONE of these. OpenAI is used when both are set.
# OpenAI key: https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Anthropic key: https://console.anthropic.com
ANTHROPIC_API_KEY=
# Without a key both features show a clear "not switched on" message.
# Shalz's chat leads are emailed through the Resend settings above.

# --- Payments for digital products (/gmb-toolkit) ----------------------------
# Razorpay serves India (INR): https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Stripe serves international (USD): https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=

# --- Analytics ---------------------------------------------------------------
# GA4 Measurement ID (G-XXXXXXXXXX). Analytics are skipped entirely when unset.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# --- Private review tools: reply helper (/r/<client>/replies?key=...), Google sign-in.
# Any long random string (16+ characters). Without it the tools are closed.
REVIEW_ADMIN_KEY=

# --- Review report storage (/r/reports) --------------------------------------
# Upstash Redis, added from Vercel > Storage > Upstash (free plan). Vercel fills these in.
# Locally, without them, counts go to .data/review-stats.json.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# --- Automatic Google review replies (docs/REVIEW_REPLIES.md) -----------------
# OAuth client from the Google Cloud project that has Business Profile API access.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Shown once after signing in at /api/gbp/connect?key=<REVIEW_ADMIN_KEY>.
GBP_REFRESH_TOKEN=
# "on" posts replies to 4-5 star reviews daily. Anything else is a dry run.
GBP_AUTO_REPLY=
# Any long random string; Vercel Cron sends it to /api/cron/review-replies.
CRON_SECRET=

# --- Sign-in for the review report (/r/login) --------------------------------
# Written by `npm run report-login` (email + password hash; the password is never stored).
# Copy the whole line into Vercel as well.
REPORT_LOGINS=
